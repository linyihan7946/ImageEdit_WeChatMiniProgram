.container {
  flex: 1;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.content {
  flex: 1;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  max-height: calc(100vh - 200rpx);
}

.title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.content-text {
  font-size: 26rpx;
  line-height: 42rpx;
  color: #666;
  white-space: pre-wrap;
}

.footer {
  margin-top: 20rpx;
  padding-bottom: 20rpx;
}

.back-btn {
  width: 100%;
  height: 80rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  line-height: 80rpx;
}

/* 滚动条样式 */
.content::-webkit-scrollbar {
  width: 8rpx;
}

.content::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 4rpx;
}

.content::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 4rpx;
}

.content::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}